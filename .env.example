# Reference template only; Vite does not load this root file automatically.
# Copy frontend/.env.example to frontend/.env.local and backend/.env.example to backend/.env.
# ---- Frontend (Vite exposes only VITE_* vars; these are safe to be public) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Local development only. Set Vercel's VITE_API_URL to the deployed backend origin.
VITE_API_URL=http://localhost:8787

# ---- Backend (SECRET: never prefix with VITE_, never commit) ----
GEMINI_API_KEY=
PORT=8787
CORS_ORIGIN=http://localhost:5173
